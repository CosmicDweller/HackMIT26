# Copy to .env.local and set to false once the real backend (POST /api/transcribe)
# is ready. Defaults to true (mock mode) when unset.
VITE_USE_MOCK_API=true

# Same pattern for the doctor-workspace auth and transcriptions services.
# Set to false once Supabase Auth and /api/transcriptions* (agreed contract
# v2 on issue #3) are ready to use for real.
VITE_USE_MOCK_AUTH=true
VITE_USE_MOCK_TRANSCRIPTIONS=true

# Required only when VITE_USE_MOCK_AUTH=false. Get these from the Supabase
# project the backend agent set up (Project Settings -> API). The anon key
# is safe to expose client-side — never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the backend lives. Leave EMPTY in development: the Vite dev server
# proxies /api to localhost:3001 for you.
#
# A production build has no such proxy. If the client and the API are
# deployed to different origins, set this to the backend's origin (no
# trailing slash) at BUILD time — it is baked into the bundle:
#   VITE_API_BASE_URL=https://scribe-api.example.com
# Leave it empty if your host rewrites /api to the backend itself.
# The backend must also allow this site's origin via its CORS_ORIGIN.
VITE_API_BASE_URL=

# The SOAP and voice-profile services follow the same mock pattern.
VITE_USE_MOCK_SOAP=true
VITE_USE_MOCK_VOICE_PROFILE=true
