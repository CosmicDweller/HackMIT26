node_modules/
.env
.env.local
# Model weights and temporary audio never go in Git
models/*
!models/.gitkeep
tmp/
*.wav
!tests/fixtures/*.wav
!tests/fixtures/synthetic/*.wav
*.webm
*.m4a
*.mp3
*.ogg

# Diarization: Python venv and downloaded models
diarization/.venv/
diarization/models/
__pycache__/

# Local transcript database (may contain transcripts; never commit)
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Voice lab: generated synthetic dataset, embeddings, Python environment and models (never commit voice data)
voice/.venv/
voice/models/
voice/lab/data/
voice/lab/*.npz
