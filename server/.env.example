# Copy to .env to override defaults. Every value is optional.
# Relative paths resolve against server/. .env is git-ignored.

PORT=3001

# Origin allowed to call the API from a browser (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# Executables: a name on PATH, or an absolute path.
FFMPEG_BIN=ffmpeg
WHISPER_BIN=whisper-cli

# Model weights (download with `npm run setup:model`).
WHISPER_MODEL=models/ggml-small.en.bin
WHISPER_LANGUAGE=en
WHISPER_THREADS=4

# Limits (defaults match docs/API_CONTRACT.md).
MAX_UPLOAD_BYTES=10485760
MAX_DURATION_SECONDS=60
PROCESS_TIMEOUT_MS=120000
MAX_CONCURRENT=2

# Directory for temporary audio (deleted after each request). Defaults to the OS temp dir.
# STT_TMP_DIR=

# --- Speaker diarization (run `npm run setup:diarization`) ---
# DIARIZATION_ENABLED=true
# DIARIZATION_PYTHON=diarization/.venv/bin/python
# Lower = more speakers detected. Tuned on synthetic voices only.
# DIARIZATION_THRESHOLD=0.4
# DIARIZATION_TIMEOUT_MS=60000

# --- Doctor accounts (Supabase Auth) ---
# The project URL. Tokens are verified against its published signing keys; no secret key is needed.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# --- Transcript database (SQLite; contains transcripts, never commit) ---
# DB_PATH=data/transcripts.sqlite

# --- Speech engine: Deepgram (the primary engine) ---
# WARNING: audio from AUTHENTICATED recordings is sent to Deepgram (every request sets mip_opt_out=true).
# The public /api/transcribe always stays local. Synthetic data only unless a BAA and the other approvals in
# docs/API_CONTRACT.md are in place. The key is a secret: only this git-ignored file, never chat, code or the frontend.
# STT_ENGINE=deepgram            # or "local" for the whisper.cpp fallback (short recordings only)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-medical
DEEPGRAM_DIARIZE_MODEL=latest
# DEEPGRAM_LANGUAGE=en
# Optional Nova-3 keyterm prompting, comma separated (no patient-identifying terms):
# DEEPGRAM_KEYTERMS=
# Optional, never silent: used once if the primary model is unavailable, and the doctor is warned.
# DEEPGRAM_FALLBACK_MODEL=nova-3-general
# DEEPGRAM_TIMEOUT_MS=540000           # must stay under Deepgram's 10 minute synchronous limit
# DEEPGRAM_SYNC_MAX_SECONDS=1800       # longer recordings need a callback; lower on a slow uplink

# --- Recordings and jobs ---
# MAX_RECORDING_SECONDS=1800          # one recording is at most 30 minutes
# MAX_RECORDING_BYTES=536870912
# UPLOAD_DIR=data/uploads              # original uploads (file-backed); deleted when a job completes
# AUDIO_RETENTION_HOURS=24             # failed jobs keep their audio this long so they can be retried
# MAX_CONCURRENT_JOBS=2
# REVIEW_WORD_CONFIDENCE=0.85          # advisory needsReview threshold

# --- Callbacks for long recordings (OFF by default; needs a public URL, see docs/API_CONTRACT.md) ---
# DEEPGRAM_CALLBACK_BASE_URL=https://your-public-host   # forwards ONLY to the callback listener
# CALLBACK_PORT=8443

# --- Doctor voice profiles (biometric data; run `npm run setup:voice` once) ---
# 32 random bytes, base64: encrypts each doctor's stored voice references (AES-256-GCM). Keep it secret and back it up:
# without it, profiles cannot be decrypted and doctors must re-enroll. Never commit it.
# VOICE_PROFILE_KEY=            # generate with: openssl rand -base64 32
# VOICE_INDEPENDENT_MAX_SECONDS=1800   # longer recordings skip the independent speaker check (with a warning)
# VOICE_ENABLED=true
# VOICE_PYTHON=voice/.venv/bin/python

# --- Speaker diarization with pyannote Community-1 (local, gated model; run `npm run setup:pyannote` once) ---
# Deepgram still transcribes; pyannote says who spoke when. Model licence: CC-BY-4.0. No Hugging Face token belongs in this file:
# log in once with `.venv-diarization/bin/hf auth login` (the token stays in Hugging Face's own cache).
# PYANNOTE_ENABLED=true
# PYANNOTE_PYTHON=.venv-diarization/bin/python
# PYANNOTE_DEVICE=cpu                   # cpu (verified baseline) | mps | cuda
# PYANNOTE_POLICY=always                # always | when-merged (only when Deepgram found at most one speaker)
# PYANNOTE_MAX_CONCURRENT_JOBS=1        # the model needs gigabytes: one at a time
# PYANNOTE_TIMEOUT_MIN_MS=120000        # a run gets max(min, audio length x factor), never more than the maximum
# PYANNOTE_TIMEOUT_FACTOR=1
# PYANNOTE_TIMEOUT_MAX_MS=3600000
# PYANNOTE_MODEL_CACHE=                 # empty = the Hugging Face default cache (~/.cache/huggingface/hub)

# --- SOAP notes (Google Gemini) ---
# Only the backend calls Gemini. NEVER put this key in a VITE_ variable or any client file.
# Free-tier key: https://aistudio.google.com/apikey  (no billing needs to be enabled)
# GEMINI_API_KEY=
# SOAP_ENABLED=true
# SOAP_PROVIDER=gemini
# SOAP_MODEL=gemini-3.6-flash        # gemini-2.5-flash is retired for new keys; 3.6-flash is Google's named replacement
# SOAP_DEFAULT_TEMPLATE=primary-care-standard
# SOAP_AUTO_GENERATE=true              # draft a note as soon as a transcript is stored
# SOAP_MAX_CONCURRENT=1                # free tier: one request at a time
# SOAP_MAX_RETRIES=2                   # only for rate limits, timeouts and 5xx
# SOAP_TIMEOUT_MS=90000
# SOAP_TEMPERATURE=0.1                 # documentation, not prose
# SOAP_MAX_OUTPUT_TOKENS=8192
